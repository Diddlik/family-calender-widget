<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="permission_rationale">Diese App zeigt anstehende Termine aus Kalendern, die bereits auf diesem Gerät synchronisiert sind. Dafür braucht sie Lesezugriff auf deine Kalender. Die Termindaten bleiben auf dem Gerät.</string>
    <string name="permission_grant">Kalenderzugriff erlauben</string>
    <string name="permission_denied">Der Kalenderzugriff wurde abgelehnt. Du kannst ihn in den App-Einstellungen erlauben.</string>
    <string name="permission_open_settings">App-Einstellungen öffnen</string>

    <string name="main_add_widget">Der Kalenderzugriff ist erlaubt. So fügst du eine Agenda hinzu: Halte eine freie Stelle auf dem Startbildschirm gedrückt, wähle „Widgets“ und dann „Family Calendar Widget“.</string>
    <string name="about_title">Über die App</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_copyright">© 2026 Pavel Eremeev · MIT-Lizenz</string>
    <string name="about_privacy">Kein Internetzugriff, keine Analyse, kein Tracking. Kalenderdaten werden nur auf dem Gerät gelesen.</string>
    <string name="about_credits">Erstellt mit AndroidX (Jetpack Compose, Glance, WorkManager, DataStore), Kotlin und kotlinx.serialization, alle unter der Apache-Lizenz 2.0, sowie RE2/J (Google, BSD-3-Clause-Lizenz).</string>

